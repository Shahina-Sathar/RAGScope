# Frontend Dockerfile for RAGScope Dashboard
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files
COPY frontend/pyproject.toml frontend/uv.lock* ./

# Install dependencies
RUN uv sync --frozen

# Copy application code
COPY frontend/ ./

# Expose Streamlit port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Create Streamlit config directory
RUN mkdir -p /root/.streamlit

# Create Streamlit config
RUN echo '[server]\nheadless = true\nport = 8501\naddress = "0.0.0.0"\nenableCORS = false\n\n[browser]\ngatherUsageStats = false' > /root/.streamlit/config.toml

# Run Streamlit
CMD ["uv", "run", "streamlit", "run", "app.py"]
